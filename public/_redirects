# Proxy the PerfectTimeTo watch list, which is deployed on its own Netlify
# site, under the /2wa path on this domain.
#
# The `!` forces proxying so the browser URL stays on perfecttimeto.com/2wa.

# API calls go to the watch list's own function.
/2wa/api/*  https://stirring-fox-78845d.netlify.app/api/:splat  200!

# Everything else (the app shell and its assets).
/2wa/*  https://stirring-fox-78845d.netlify.app/:splat  200!

# The bare path, without a trailing slash.
/2wa  https://stirring-fox-78845d.netlify.app/  200!
